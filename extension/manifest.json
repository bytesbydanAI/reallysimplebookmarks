{
  "manifest_version": 3,
  "name": "Really Simple Bookmarks",
  "version": "1.0.0",
  "description": "Bookmark the current page to your self-hosted bookmark server.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "reallysimplebookmarks@example.com",
      "strict_min_version": "109.0"
    }
  }
}
